# Gemini API key - lấy tại https://aistudio.google.com/apikey
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model dùng để đọc ảnh. Mặc định dùng alias "luôn là bản mới nhất" của Google để tránh bị lỗi
# 404 khi Google ngừng hỗ trợ 1 phiên bản model cụ thể theo thời gian.
# Có thể đổi sang gemini-pro-latest để chính xác hơn (nhưng chậm/đắt hơn).
# Nếu gặp lỗi 404 "model is no longer available", xem danh sách model hiện có tại
# https://ai.google.dev/gemini-api/docs/models và đổi giá trị bên dưới.
GEMINI_MODEL=gemini-flash-latest

# Link "Web app URL" lấy được sau khi Deploy Google Apps Script (xem google-apps-script/Code.gs
# và README.md để biết cách tạo). Có thể để trống và nhập trực tiếp trên giao diện web.
GOOGLE_SCRIPT_URL=

# Phải trùng với biến SECRET đặt trong Code.gs (nếu bạn có đặt). Để trống nếu không dùng.
GOOGLE_SCRIPT_SECRET=

# Tên tab trong Google Sheet sẽ ghi dữ liệu vào. Để trống = ghi vào tab đang mở của Sheet.
GOOGLE_SHEET_TAB=
