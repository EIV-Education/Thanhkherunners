# Gemini API key - lấy tại https://aistudio.google.com/apikey
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model dùng để đọc ảnh (mặc định gemini-2.5-flash, có thể đổi sang gemini-2.5-pro để chính xác hơn)
GEMINI_MODEL=gemini-2.5-flash

# Đường dẫn tới file service account JSON của Google Cloud (dùng để ghi Google Sheets)
GOOGLE_CREDENTIALS_FILE=credentials/service_account.json

# ID của Google Sheet đích (lấy trong URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit)
GOOGLE_SHEET_ID=

# Tên tab trong Google Sheet sẽ ghi dữ liệu vào
GOOGLE_SHEET_TAB=Sheet1
