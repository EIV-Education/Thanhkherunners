# Anthropic API key - lấy tại https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model dùng để đọc ảnh (mặc định claude-opus-4-8, có thể đổi sang claude-sonnet-5 nếu muốn tiết kiệm chi phí)
ANTHROPIC_MODEL=claude-opus-4-8

# Đường dẫn tới file service account JSON của Google Cloud
GOOGLE_CREDENTIALS_FILE=credentials/service_account.json

# ID của Google Sheet đích (lấy trong URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit)
GOOGLE_SHEET_ID=

# Tên tab trong Google Sheet sẽ ghi dữ liệu vào
GOOGLE_SHEET_TAB=Sheet1
